{
  "info": {
    "_postman_id": "e2e-purchase-pipeline-v1",
    "name": "The Casa Chill & Coffe - E2E Purchase Pipeline",
    "description": "Flujo de compra completo. Cubre desde el Login hasta la entrega final del pedido.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Cliente: Autenticación y Perfil",
      "item": [
        {
          "name": "1.1 Login Firebase (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.idToken) { pm.collectionVariables.set(\"auth_token_firebase_client\", jsonData.idToken); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@coffee.com\",\n    \"password\": \"123456\",\n    \"returnSecureToken\": true\n}"
            },
            "url": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebase_api_key}}"
          }
        },
        {
          "name": "1.2 Intercambio Token (Verify)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) { pm.collectionVariables.set(\"auth_token_client\", jsonData.access_token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firebase_token\": \"{{auth_token_firebase_client}}\"\n}"
            },
            "url": "{{base_url}}/auth/verify"
          }
        },
        {
          "name": "1.3 Completar Perfil (Nombre/Teléfono)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token_client}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"Usuario Test E2E\",\n    \"telefono\": \"+525512345678\"\n}"
            },
            "url": "{{base_url}}/user/profile"
          }
        },
        {
          "name": "1.4 Configurar Dirección",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) { pm.collectionVariables.set(\"target_address_id\", jsonData.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token_client}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"calle\": \"Av. Reforma 123\",\n    \"ciudad\": \"CDMX\",\n    \"codigoPostal\": \"06600\",\n    \"esDefault\": true\n}"
            },
            "url": "{{base_url}}/user/addresses"
          }
        }
      ]
    },
    {
      "name": "2. Cliente: Compra",
      "item": [
        {
          "name": "2.1 Ver Productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0) { pm.collectionVariables.set(\"target_product_id\", jsonData.data[0].id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": { "method": "GET", "url": "{{base_url}}/products" }
        },
        {
          "name": "2.2 Añadir al Carrito",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token_client}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"productId\": \"{{target_product_id}}\",\n    \"cantidad\": 1\n}"
            },
            "url": "{{base_url}}/cart/add"
          }
        },
        {
          "name": "2.3 Checkout (Crear Pedido)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.orderId) { pm.collectionVariables.set(\"current_order_id\", jsonData.orderId); }",
                  "console.log('✅ Pedido creado:', jsonData.orderId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_client}}" },
              { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"shippingMethodId\": 2,\n    \"addressId\": \"{{target_address_id}}\",\n    \"tipoPago\": \"tarjeta\"\n}"
            },
            "url": "{{base_url}}/orders/checkout"
          }
        }
      ]
    },
    {
      "name": "3. Admin: Gestión",
      "item": [
        {
          "name": "3.1 Login Admin (Verify)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) { pm.collectionVariables.set(\"auth_token_admin\", jsonData.access_token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firebase_token\": \"REEMPLAZA_CON_ID_TOKEN_ADMIN_MANUAL\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "3.2 Aceptar Pedido (Preparing)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token_admin}}" }],
            "body": { "mode": "raw", "raw": "{\"status\": \"preparing\"}" },
            "url": "{{base_url}}/admin/orders/{{current_order_id}}/status"
          }
        },
        {
          "name": "3.3 Finalizar Pedido (Delivered)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token_admin}}" }],
            "body": { "mode": "raw", "raw": "{\"status\": \"delivered\"}" },
            "url": "{{base_url}}/admin/orders/{{current_order_id}}/status"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "firebase_api_key", "value": "YOUR_FIREBASE_KEY" },
    { "key": "auth_token_firebase_client", "value": "" },
    { "key": "auth_token_client", "value": "" },
    { "key": "auth_token_admin", "value": "" },
    { "key": "target_product_id", "value": "" },
    { "key": "target_address_id", "value": "" },
    { "key": "current_order_id", "value": "" }
  ]
}