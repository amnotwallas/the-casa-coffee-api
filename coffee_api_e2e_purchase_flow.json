{
  "info": {
    "_postman_id": "e2e-purchase-pipeline-v1",
    "name": "The Casa Chill & Coffe - E2E Purchase Pipeline",
    "description": "Flujo de compra completo (End-to-End). Demuestra la interacción entre un Cliente realizando un pedido y un Administrador gestionando los estados hasta la entrega.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Cliente: Experiencia de Compra",
      "item": [
        {
          "name": "1.1 Ver Catálogo de Productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set(\"target_product_id\", jsonData.data[0].id);",
                  "    console.log(\"Producto seleccionado: \" + jsonData.data[0].nombre);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products"
          }
        },
        {
          "name": "1.2 Añadir al Carrito",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_client}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"productId\": \"{{target_product_id}}\",\n    \"cantidad\": 2,\n    \"personalizaciones\": {\n        \"Leche\": \"Almendra\",\n        \"Tamaño\": \"Grande\"\n    }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/cart/add"
          }
        },
        {
          "name": "1.3 Ver Carrito",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_client}}" }
            ],
            "url": "{{base_url}}/cart"
          }
        },
        {
          "name": "1.4 Checkout (Crear Pedido)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uuid = require('uuid');",
                  "pm.variables.set('idempotency_key', uuid.v4());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.orderId) {",
                  "    pm.collectionVariables.set(\"current_order_id\", jsonData.orderId);",
                  "    console.log(\"✅ Pedido creado exitosamente: \" + jsonData.orderId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_client}}" },
              { "key": "X-Idempotency-Key", "value": "{{idempotency_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"addressId\": \"addr-local-1\",\n    \"tipoPago\": \"tarjeta\",\n    \"tipoPedido\": \"delivery\",\n    \"notas\": \"Dejar en recepción\",\n    \"propina\": 15.0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/orders/checkout"
          }
        }
      ]
    },
    {
      "name": "2. Administrador: Gestión de Operaciones",
      "item": [
        {
          "name": "2.1 Revisar Cola de Pedidos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_admin}}" }
            ],
            "url": "{{base_url}}/admin/orders"
          }
        },
        {
          "name": "2.2 Aceptar Pedido (Preparing)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_admin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"preparing\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/admin/orders/{{current_order_id}}/status"
          }
        },
        {
          "name": "2.3 Pedido Listo en Barra (Ready)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_admin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"ready\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/admin/orders/{{current_order_id}}/status"
          }
        },
        {
          "name": "2.4 Pedido Entregado (Delivered)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_admin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"delivered\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/admin/orders/{{current_order_id}}/status"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "auth_token_client",
      "value": "INSERTA_TOKEN_DE_CLIENTE",
      "type": "string"
    },
    {
      "key": "auth_token_admin",
      "value": "INSERTA_TOKEN_DE_ADMIN",
      "type": "string"
    },
    {
      "key": "target_product_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "current_order_id",
      "value": "",
      "type": "string"
    }
  ]
}