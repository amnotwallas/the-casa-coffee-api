{
  "info": {
    "_postman_id": "coffee-api-client-v1",
    "name": "The Casa Chill & Coffe - CLIENT MASTER",
    "description": "Colección completa para la App de Clientes. Autenticación vía Firebase. IMPORTANTE: Pegar el token obtenido en la variable 'auth_token_client' para que el Runner funcione automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Autenticación Firebase (Obtener ID Token)",
      "item": [
        {
          "name": "Login con Email (Identity Toolkit)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.idToken) {",
                  "    pm.collectionVariables.set(\"auth_token_client\", jsonData.idToken);",
                  "    pm.environment.set(\"auth_token_client\", jsonData.idToken);",
                  "    console.log('Token guardado exitosamente');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@coffee.com\",\n    \"password\": \"123456\",\n    \"returnSecureToken\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebase_api_key}}"
          }
        },
        {
          "name": "Sincronizar Usuario (Verify)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.user) {",
                  "    pm.environment.set(\"auth_token_client\", pm.variables.get(\"auth_token_client\"));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firebase_token\": \"{{auth_token_client}}\",\n    \"nombre\": \"Juan Pérez\",\n    \"telefono\": \"+525512345678\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/verify"
          }
        },
        {
          "name": "Cerrar Sesión",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "1. Perfil de Usuario",
      "item": [
        {
          "name": "Ver Mi Perfil",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/user/profile"
          }
        },
        {
          "name": "Actualizar Perfil",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"Juan Pérez Actualizado\",\n    \"telefono\": \"+5211223344\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/user/profile"
          }
        },
        {
          "name": "Listar Direcciones",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.length > 0) {",
                  "    pm.collectionVariables.set(\"active_address_id\", jsonData[0].id);",
                  "    pm.environment.set(\"active_address_id\", jsonData[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/user/addresses"
          }
        },
        {
          "name": "Añadir Dirección",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"calle\": \"Reforma 222\",\n    \"ciudad\": \"CDMX\",\n    \"codigoPostal\": \"06600\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/user/addresses"
          }
        },
        {
          "name": "Eliminar Dirección",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/user/addresses/{{active_address_id}}"
          }
        },
        {
          "name": "Ver Favoritos",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/user/favorites"
          }
        },
        {
          "name": "Añadir a Favoritos",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/user/favorites/{{active_product_id}}"
          }
        }
      ]
    },
    {
      "name": "2. Catálogo de Productos",
      "item": [
        {
          "name": "Listar Todos los Productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set(\"active_product_id\", jsonData.data[0].id);",
                  "    pm.environment.set(\"active_product_id\", jsonData.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products"
          }
        },
        {
          "name": "Filtrar por Categoría (2=Cafés)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products?category=2"
          }
        },
        {
          "name": "Ver Detalle Producto",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/{{active_product_id}}"
          }
        },
        {
          "name": "Búsqueda Rápida",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/search?q=espresso"
          }
        },
        {
          "name": "Ver Reseñas de Producto",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/{{active_product_id}}/reviews"
          }
        }
      ]
    },
    {
      "name": "3. Carrito de Compras",
      "item": [
        {
          "name": "Ver Mi Carrito",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cart"
          }
        },
        {
          "name": "Añadir al Carrito",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"productId\": \"{{active_product_id}}\",\n    \"cantidad\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/cart/add"
          }
        },
        {
          "name": "Aplicar Cupón",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/cart/apply-coupon?code=COFFEE10"
          }
        },
        {
          "name": "Vaciar Carrito",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/cart/clear"
          }
        }
      ]
    },
    {
      "name": "4. Pedidos & Tracking",
      "item": [
        {
          "name": "Checkout (Finalizar Pedido)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.request.headers.add({ key: 'X-Idempotency-Key', value: 'auto-' + pm.variables.replaceIn('{{$guid}}') });"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.orderId) {",
                  "    pm.collectionVariables.set(\"last_order_id\", jsonData.orderId);",
                  "    pm.environment.set(\"last_order_id\", jsonData.orderId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"addressId\": \"{{active_address_id}}\",\n    \"tipoPago\": \"tarjeta\",\n    \"tipoPedido\": \"delivery\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/orders/checkout"
          }
        },
        {
          "name": "Mis Pedidos Activos",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/active"
          }
        },
        {
          "name": "Seguimiento (Tracking)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/{{last_order_id}}/tracking"
          }
        }
      ]
    },
    {
      "name": "5. Soporte & IA",
      "item": [
        {
          "name": "IA - Mensaje Bienvenida",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/chat/welcome"
          }
        },
        {
          "name": "IA - Enviar Mensaje",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"message\": \"¿Tienen café helado?\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/chat/message"
          }
        },
        {
          "name": "Soporte - Horarios",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/store/hours"
          }
        },
        {
          "name": "Soporte - FAQ",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/faq"
          }
        },
        {
          "name": "Soporte - Notificaciones",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/notifications"
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token_client}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "firebase_api_key", "value": "PEGAR_API_KEY_AQUI" },
    { "key": "auth_token_client", "value": "" },
    { "key": "auth_token_client", "value": "" },
    { "key": "active_product_id", "value": "" },
    { "key": "active_address_id", "value": "" },
    { "key": "last_order_id", "value": "" }
  ]
}
