{
  "info": {
    "_postman_id": "coffee-api-admin-v1",
    "name": "The Casa Chill & Coffe - ADMIN MASTER",
    "description": "Colección MAESTRA de Administración (Seguridad RBAC). Usa la variable auth_token_admin para todas las peticiones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Autenticación Admin",
      "item": [
        {
          "name": "Login Admin (Firebase)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.user && jsonData.user.is_admin) {",
                  "    // Tomamos el token directamente del body que tú enviaste",
                  "    var requestBody = JSON.parse(pm.request.body.raw);",
                  "    var token = requestBody.firebase_token;",
                  "    pm.collectionVariables.set(\"auth_token_admin\", token);",
                  "    pm.environment.set(\"auth_token_admin\", token);",
                  "    console.log('✅ auth_token_admin actualizado correctamente');",
                  "} else {",
                  "    console.warn('⚠️ Usuario no es admin o error de login');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firebase_token\": \"{{auth_token_admin}}\",\n    \"nombre\": \"Admin\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "1. Dashboard & Analytics",
      "item": [
        {
          "name": "Ver Analíticas Hoy",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/analytics"
          }
        }
      ]
    },
    {
      "name": "2. Gestión de Catálogo",
      "item": [
        {
          "name": "Listar Todos (y capturar ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set(\"last_admin_product_id\", jsonData.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products"
          }
        },
        {
          "name": "Crear Nuevo Producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"last_admin_product_id\", jsonData.id);",
                  "    pm.environment.set(\"last_admin_product_id\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"id\": \"latte-auto-{{$randomInt}}\",\n    \"nombre\": \"Café Especial Admin\",\n    \"descripcion\": \"Creado desde el Dashboard\",\n    \"precio\": 65.0,\n    \"intensidad\": 3,\n    \"imagenes\": [\"espresso.png\"],\n    \"category_id\": 2,\n    \"ingredientes\": [\"Calidad Admin\"],\n    \"valores_nutricionales\": {\n        \"calorias\": 100,\n        \"proteinas\": 5.0,\n        \"grasas\": 2.0,\n        \"carbohidratos\": 10.0\n    },\n    \"personalizaciones\": [],\n    \"reviews_count\": 0,\n    \"rating_avg\": 0.0,\n    \"disponible\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/admin/products"
          }
        },
        {
          "name": "Actualizar Producto",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"precio\": 72.0,\n    \"disponible\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/admin/products/{{last_admin_product_id}}"
          }
        },
        {
          "name": "Eliminar Producto",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/admin/products/{{last_admin_product_id}}"
          }
        }
      ]
    },
    {
      "name": "3. Gestión de Pedidos",
      "item": [
        {
          "name": "Listar Todos los Pedidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.length > 0) {",
                  "    pm.collectionVariables.set(\"last_admin_order_id\", jsonData[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/orders"
          }
        },
        {
          "name": "Avanzar a 'Preparando'",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"preparing\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/admin/orders/{{last_admin_order_id}}/status"
          }
        },
        {
          "name": "Marcar como 'Listo'",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"ready\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/admin/orders/{{last_admin_order_id}}/status"
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token_admin}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "auth_token_admin", "value": "" },
    { "key": "last_admin_product_id", "value": "" },
    { "key": "last_admin_order_id", "value": "" }
  ]
}
