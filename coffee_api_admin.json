{
  "info": {
    "_postman_id": "coffee-api-admin-v1",
    "name": "The Casa Chill & Coffee - ADMIN MASTER",
    "description": "Colección MAESTRA de Administración. Control total del catálogo, pedidos y analíticas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Autenticación Admin",
      "item": [
        {
          "name": "Login Admin (Verify)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token && jsonData.user.is_admin) {",
                  "    pm.collectionVariables.set(\"auth_token_admin\", jsonData.access_token);",
                  "    pm.environment.set(\"auth_token_admin\", jsonData.access_token);",
                  "    console.log('✅ auth_token_admin (JWT Local) actualizado');",
                  "} else {",
                  "    console.warn('⚠️ Usuario no es admin o error de login');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firebase_token\": \"{{auth_token_firebase_admin}}\",\n    \"nombre\": \"Admin\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "1. Dashboard & Analytics",
      "item": [
        {
          "name": "Ver Analíticas Hoy",
          "request": { "method": "GET", "url": "{{base_url}}/admin/analytics" }
        }
      ]
    },
    {
      "name": "2. Gestión de Catálogo",
      "item": [
        {
          "name": "Crear Producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) { pm.collectionVariables.set(\"last_admin_product_id\", jsonData.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"Café Especial Admin\",\n    \"descripcion\": \"Creado desde el Dashboard\",\n    \"precio\": 65.0,\n    \"intensidad\": 3,\n    \"imagenes\": [\"espresso.png\"],\n    \"category_id\": 2,\n    \"ingredientes\": [\"Calidad Admin\"],\n    \"valores_nutricionales\": {\n        \"calorias\": 100,\n        \"proteinas\": 5.0,\n        \"grasas\": 2.0,\n        \"carbohidratos\": 10.0\n    },\n    \"personalizaciones\": [\n        {\n            \"tipo\": \"Leche\",\n            \"opciones\": [\n                {\"nombre\": \"Entera\", \"extra_precio\": 0.0},\n                {\"nombre\": \"Almendra\", \"extra_precio\": 12.0}\n            ]\n        }\n    ],\n    \"disponible\": true\n}"
            },
            "url": "{{base_url}}/admin/products"
          }
        },
        {
          "name": "Actualizar Producto",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"precio\": 75.0,\n    \"disponible\": true\n}"
            },
            "url": "{{base_url}}/admin/products/{{last_admin_product_id}}"
          }
        },
        {
          "name": "Eliminar Producto",
          "request": { "method": "DELETE", "url": "{{base_url}}/admin/products/{{last_admin_product_id}}" }
        }
      ]
    },
    {
      "name": "3. Gestión de Pedidos",
      "item": [
        {
          "name": "Listar Todos los Pedidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.length > 0) {",
                  "    pm.collectionVariables.set(\"last_admin_order_id\", jsonData[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": { "method": "GET", "url": "{{base_url}}/admin/orders" }
        },
        {
          "name": "Actualizar Estado de Pedido",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"preparing\"\n}"
            },
            "url": "{{base_url}}/admin/orders/{{last_admin_order_id}}/status"
          }
        }
      ]
    },
    {
      "name": "4. Notificaciones",
      "item": [
        {
          "name": "Listar Notificaciones",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.length > 0) {",
                  "    pm.collectionVariables.set(\"last_admin_notif_id\", jsonData[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": { "method": "GET", "url": "{{base_url}}/admin/notifications" }
        },
        {
          "name": "Marcar Notificación como Leída",
          "request": { "method": "PATCH", "url": "{{base_url}}/admin/notifications/{{last_admin_notif_id}}/read" }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{auth_token_admin}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "auth_token_admin", "value": "" },
    { "key": "auth_token_firebase_admin", "value": "" },
    { "key": "last_admin_product_id", "value": "" },
    { "key": "last_admin_order_id", "value": "" },
    { "key": "last_admin_notif_id", "value": "" }
  ]
}